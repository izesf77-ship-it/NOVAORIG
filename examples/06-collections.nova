// Arrays and maps.

fn main() {
    // Array literals
    fruits = ["apple", "banana", "cherry"]
    print("fruits: {fruits}")
    print("len: {len(fruits)}")
    
    // Map literals
    scores = {"alice": 100, "bob": 85, "charlie": 92}
    print("alice's score: {scores["alice"]}")
    
    // Iteration
    print("--- fruits ---")
    for fruit in fruits {
        print(fruit)
    }
    
    print("--- scores ---")
    for name in keys(scores) {
        print("{name}: {scores[name]}")
    }
    
    // Range
    nums = range(5)
    print("range(5): {nums}")
    
    // Reduce-like pattern
    total = 0
    for n in nums { total = total + n }
    print("sum of range(5): {total}")
    
    // Nested structures
    users = [
        {"name": "Alice", "age": 30},
        {"name": "Bob", "age": 25},
    ]
    for u in users {
        print("{u["name"]} is {u["age"]}")
    }
}