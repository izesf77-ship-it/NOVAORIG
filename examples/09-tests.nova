// Tests with `test "name" { ... }` blocks.

fn add(a: Int, b: Int) -> Int { a + b }

fn is_even(n: Int) -> Bool { n % 2 == 0 }

fn factorial(n: Int) -> Int {
    if n <= 1 { 1 } else { n * factorial(n - 1) }
}

test "add works" {
    expect(add(1, 2) == 3)
    expect(add(-1, 1) == 0)
    expect(add(0, 0) == 0)
}

test "is_even works" {
    expect(is_even(0))
    expect(is_even(2))
    expect(is_even(100))
    expect(not is_even(1))
    expect(not is_even(7))
}

test "factorial works" {
    expect(factorial(0) == 1)
    expect(factorial(1) == 1)
    expect(factorial(5) == 120)
    expect(factorial(10) == 3628800)
}

fn main() {
    print("Run 'nova test examples/09-tests.nova' to execute tests.")
}